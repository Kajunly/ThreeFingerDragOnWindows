<Page
    x:Class="ThreeFingerDragOnWindows.settings.ThreeFingerDragSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wuc="using:WinUICommunity"
    xmlns:local="using:ThreeFingerDragOnWindows.touchpad"
    mc:Ignorable="d">


    <ScrollView Margin="0"
                HorizontalAlignment="Stretch"
                VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,0,20,20"
                    ChildrenTransitions="{StaticResource SettingsCardsAnimations}"
                    Spacing="5">

            <InfoBar
                Title="三指拖拽在本设置窗口中可能无法正常工作，但你可以在其他窗口上试用。"
                IsIconVisible="False"
                IsOpen="True"
                IsClosable="True"
                Severity="Warning" />

            <wuc:SettingsCard
                Description="允许用三指在触控板上选中文字、拖动窗口和其他对象（模拟左键点击）。"
                HeaderIcon="{wuc:BitmapIcon Source='ms-appx:///Assets/icon-threefinger.png', ShowAsMonochrome=True}"
                Header="启用三指拖拽">
                <ToggleSwitch x:Name="Enabled"
                              IsOn="{x:Bind EnabledProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </wuc:SettingsCard>

            <wuc:SettingsExpander
                IsEnabled="{Binding ElementName=Enabled, Path=IsOn}"
                Description="你可以在 Windows 设置（蓝牙和其他设备 > 触控板）中进行此操作。你也可以关闭“双击两次并拖动以进行多选”。"
                Header="请确保关闭 Windows 的三指拖拽手势"
                IsExpanded="False"
                HeaderIcon="{wuc:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xEA37;}">
                <HyperlinkButton Content="前往设置"
                                 Click="OpenSettings" />
                <wuc:SettingsExpander.ItemsHeader>
                    <InfoBar
                        BorderThickness="0"
                        CornerRadius="0"
                        IsIconVisible="False"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Margin="-17,0,0,0">
                        <Grid Margin="5"
                              ColumnSpacing="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Image Source="ms-appx:///Assets/TouchpadThreeFingerSettings.png"
                                   Grid.Column="0"
                                   VerticalAlignment="Top" />
                            <Image Source="ms-appx:///Assets/TouchpadTapsSettings.png"
                                   Grid.Column="1"
                                   VerticalAlignment="Top" />
                        </Grid>
                    </InfoBar>
                </wuc:SettingsExpander.ItemsHeader>

            </wuc:SettingsExpander>

            <wuc:SettingsCard
                Description="按住该按钮以便选择文字和拖动对象。"
                HeaderIcon="{wuc:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE962;}"
                Header="拖拽时按住哪个鼠标按键">
                <ComboBox x:Name="ButtonType"
                          SelectedIndex="{x:Bind ButtonTypeProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          MinWidth="240">
                    <x:String>无</x:String>
                    <x:String>左键</x:String>
                    <x:String>右键</x:String>
                    <x:String>中键</x:String>
                </ComboBox>
            </wuc:SettingsCard>

            <wuc:SettingsExpander
                IsEnabled="{Binding ElementName=Enabled, Path=IsOn}"
                Description="松开三指后，只用一根或两根手指会立即松开点击；但如果你继续按住，点击只会在短暂延迟后松开。此功能允许你在不松开点击的情况下重新摆放手指位置。"
                Header="允许松开手指并在不松开点击的情况下重新开始拖拽"
                HeaderIcon="{wuc:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE8B0;}"
                IsExpanded="True">
                <ToggleSwitch x:Name="AllowReleaseAndRestart"
                              IsOn="{x:Bind AllowReleaseAndRestartProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <wuc:SettingsExpander.Items>
                    <wuc:SettingsCard Description="推荐值：500 毫秒。"
                                      Header="松开点击前的延迟（毫秒）"
                                      IsEnabled="{Binding ElementName=AllowReleaseAndRestart, Path=IsOn}">
                        <NumberBox MinWidth="240"
                                   LargeChange="50"
                                   Maximum="2000"
                                   Minimum="0"
                                   SmallChange="100"
                                   SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind ReleaseDelayProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </wuc:SettingsCard>
                </wuc:SettingsExpander.Items>

            </wuc:SettingsExpander>

            <ItemsControl ItemsSource="{x:Bind MouseSpeedSettingItems}" Style="{x:Null}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:MouseSpeedSettings">
                        <wuc:SettingsExpander
                            IsEnabled="{Binding ElementName=Enabled, Path=IsOn}"
                            Description="默认情况下，触控板上的三指移动不会影响鼠标指针，ThreeFingerDragOnWindows 会自行处理光标移动。与单指控制相比，这可能会产生一些差异。你可以在此处自定义此行为；如果你找到了用三指移动光标的其他方法，也可以将其禁用。"
                            Header="{x:Bind Header}"
                            HeaderIcon="{wuc:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE7C2;}"
                            IsExpanded="True">
                            <ToggleSwitch x:Name="CursorMove"
                                          IsOn="{x:Bind CursorMoveProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <wuc:SettingsExpander.Items>
                                <!-- content is an alignment of a numberbox and a slider  in a horizontal box -->
                                <wuc:SettingsCard Header="鼠标速度"
                                                  Description="默认为 30"
                                                  IsEnabled="{Binding ElementName=CursorMove, Path=IsOn}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
                                        <!-- Slider -->
                                        <Slider MinWidth="200"
                                                StepFrequency="1"
                                                Maximum="200"
                                                Minimum="1"
                                                Value="{x:Bind CursorSpeedProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- NumberBox -->
                                        <NumberBox MinWidth="80"
                                                   Value="{x:Bind CursorSpeedProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Maximum="100000"
                                                   Minimum="0"
                                                   SmallChange="5"
                                                   LargeChange="10"
                                                   SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                </wuc:SettingsCard>
                                       
                                <wuc:SettingsCard Description="默认为 10，设为 0 表示禁用。"
                                                  Header="鼠标加速度"
                                                  IsEnabled="{Binding ElementName=CursorMove, Path=IsOn}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
                                        <Slider MinWidth="200"
                                                StepFrequency="1"
                                                Maximum="30"
                                                Minimum="0"
                                                Value="{x:Bind CursorAccelerationProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <NumberBox MinWidth="80"
                                                   Value="{x:Bind CursorAccelerationProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Minimum="0"
                                                   Maximum="1000"
                                                   SmallChange="5"
                                                   LargeChange="10"
                                                   SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                </wuc:SettingsCard>
                            </wuc:SettingsExpander.Items>

                        </wuc:SettingsExpander>
                        
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <wuc:SettingsCard
                HeaderIcon="{wuc:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE768;}"
                Header="开始拖拽的鼠标移动阈值"
                Description="仅当三指移动使光标移动至少此距离时，拖拽才会开始。这用于区分三指手势和四指手势。推荐值：100 像素">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
                    <Slider MinWidth="150"
                            StepFrequency="1"
                            Maximum="200"
                            Minimum="0"
                            Value="{x:Bind StartDragThresholdProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <NumberBox MinWidth="80"
                               Value="{x:Bind StartDragThresholdProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Minimum="0"
                               Maximum="1000"
                               SmallChange="5"
                               LargeChange="20"
                               SpinButtonPlacementMode="Compact" />
                </StackPanel>

            </wuc:SettingsCard>
            <wuc:SettingsCard
                HeaderIcon="{wuc:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE71A;}"
                Header="结束拖拽的鼠标移动阈值"
                Description="当单指移动使光标移动至少此距离时，拖拽会结束。推荐值：10 像素。此阈值不能高于开始拖拽阈值。">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
                    <Slider MinWidth="150"
                            StepFrequency="1"
                            Maximum="200"
                            Minimum="0"
                            Value="{x:Bind StopDragThresholdProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <NumberBox MinWidth="80"
                               Value="{x:Bind StopDragThresholdProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Minimum="0"
                               Maximum="1000"
                               SmallChange="1"
                               LargeChange="5"
                               SpinButtonPlacementMode="Compact" />
                </StackPanel>
            </wuc:SettingsCard>

            <Expander
                IsExpanded="False"
                ExpandDirection="Down"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Header="故障排查">

                <StackPanel Margin="0,0,0,0"
                            ChildrenTransitions="{StaticResource SettingsCardsAnimations}"
                            Spacing="5">

                    <wuc:SettingsCard
                        Description="如果手指单次移动超过此距离，该记录将被丢弃。可用于防止因触控板报告跳变而导致光标跳动。设为 0 表示禁用此限制，默认为 0。"
                        Header="限制手指单次可移动的最大距离">

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
                            <Slider MinWidth="150"
                                    StepFrequency="1"
                                    Maximum="200"
                                    Minimum="0"
                                    Value="{x:Bind MaxFingerMoveDistanceProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <NumberBox MinWidth="80"
                                       Value="{x:Bind MaxFingerMoveDistanceProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Minimum="0"
                                       Maximum="10000"
                                       SmallChange="5"
                                       LargeChange="10"
                                       SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                    </wuc:SettingsCard>

                    <wuc:SettingsCard
                        Description="基于最近 N 次输入的平均值移动光标。提高该值可让光标移动更平滑。仅在遇到问题时才修改此设置，因为它会增加延迟。默认为 1。"
                        Header="平均光标移动">
                        <NumberBox MinWidth="60"
                                   Value="{x:Bind CursorAveragingProperty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Minimum="1"
                                   Maximum="10"
                                   SmallChange="1"
                                   LargeChange="1"
                                   SpinButtonPlacementMode="Compact" />
                    </wuc:SettingsCard>

                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollView>

</Page>
